<!-- Navigation Header (Clean Ivory & Champagne Gold) -->
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-logo">
      <span class="brand-name">ZAHAR</span>
      <span class="brand-subtitle">HAUTE PARFUMERIE</span>
    </a>

    <nav class="nav-menu">
      <a href="/#vault" class="nav-link">Fragrance Vault</a>
      <a href="/#maison-offers" class="nav-link">Special Offers</a>
      <a href="/#discovery-wardrobe" class="nav-link">Discovery Set ($45)</a>
      <a href="/#pyramid" class="nav-link">Olfactory Notes</a>
      <a href="/#layering" class="nav-link">The Layering Ritual</a>
      <a href="/shop" class="nav-link">All Vault Scents</a>
    </nav>

    <div class="header-tools">
      <div class="currency-selector" style="display: flex; align-items: center;">
        <select id="currencySelect" aria-label="Select Currency">
          <option value="USD">USD ($)</option>
          <option value="EUR">EUR (€)</option>
          <option value="GBP">GBP (£)</option>
          <option value="AED">AED (د.إ)</option>
        </select>
      </div>

      <button class="tool-btn" id="openSearchBtn" title="Search" onclick="document.getElementById('searchDrawerOverlay')?.classList.add('active');" aria-label="Search">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </button>

      <button class="cart-trigger-btn" id="openCartBtn" onclick="openCart()" aria-label="Open Bag">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
        <span>Bag</span>
        <span class="cart-pill-count" id="cartPillCount"><%= (typeof cartData !== 'undefined' && cartData) ? cartData.itemCount : ((typeof cart !== 'undefined' && cart) ? cart.reduce((s,i)=>s+i.quantity,0) : 0) %></span>
      </button>

      <button class="mobile-toggle" id="mobileMenuToggle" aria-label="Toggle Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
