  <!-- ═══ SLIDE-IN CART DRAWER ════════════════════════════════════ -->
  <div class="cart-drawer-overlay" id="cartOverlay"></div>
  <aside class="cart-drawer" id="cartDrawer">
    <div class="cart-drawer-head">
      <h3>Your Fragrance Bag (<span id="cartDrawerCount"><%= cartData ? cartData.itemCount : 0 %></span>)</h3>
      <span class="cart-close-icon" id="closeCartBtn">✕</span>
    </div>

    <!-- Free Shipping & Gift Milestone Tracker ($150 threshold) -->
    <div class="cart-tier-tracker">
      <div class="tier-status-text">
        <span id="tierLabel">Complimentary Courier Threshold: $150.00</span>
        <strong id="tierRemaining">$150.00 away</strong>
      </div>
      <div class="tier-bar-track">
        <div class="tier-bar-fill" id="tierBarFill" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Scrollable Items List -->
    <div class="cart-items-scrollable" id="cartDrawerItems">
      <!-- Injected dynamically via JS -->
    </div>

    <!-- Cart Footer with Promo Code & Total -->
    <div class="cart-drawer-foot">
      <div class="cart-coupon-row">
        <input type="text" id="couponInput" placeholder="PROMO CODE (e.g. ROYAL15)">
        <button type="button" onclick="applyCouponCode()">Apply</button>
      </div>

      <div class="cart-breakdown-row">
        <span>Subtotal</span>
        <span id="cartDrawerSubtotal">$0.00</span>
      </div>
      <div class="cart-breakdown-row" id="discountRow" style="display: none; color: #2E7D32;">
        <span id="discountLabel">VIP Discount (15%)</span>
        <span id="discountAmount">-$0.00</span>
      </div>
      <div class="cart-breakdown-row">
        <span>Delivery</span>
        <span id="deliveryLabel" style="color: var(--gold-dark); font-weight: 600;">Complimentary over $150</span>
      </div>
      <div class="cart-breakdown-row total-row">
        <span>Estimated Total</span>
        <span id="cartDrawerTotal">$0.00</span>
      </div>

      <a href="/checkout" class="btn-gold" style="display: block; text-align: center; width: 100%;">
        Proceed to Secure Checkout →
      </a>
      <div style="font-size: 0.7rem; color: var(--text-dim); text-align: center; margin-top: 10px;">
        🔒 Encrypted 256-Bit SSL • Complimentary Gift Packaging Included
      </div>
    </div>
  </aside>

  <!-- ═══ LIVE SEARCH DRAWER OVERLAY ══════════════════════════════ -->
  <div class="search-drawer-overlay" id="searchDrawerOverlay">
    <div class="search-container">
      <div class="search-input-box">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" id="liveSearchInput" placeholder="Search by note (e.g., Saffron, Oud, Rose, Amber)..." autocomplete="off">
        <span class="search-close-btn" id="closeSearchBtn">✕</span>
      </div>

      <div class="search-results-tray" id="searchResultsTray">
        <!-- Rendered live via JS -->
      </div>
    </div>
  </div>

  <!-- ═══ QUICK VIEW MODAL OVERLAY ════════════════════════════════ -->
  <div class="qv-modal-overlay" id="qvModal">
    <div class="qv-modal-card">
      <button class="qv-close-btn" id="closeQvBtn">✕</button>
      <div class="qv-image-box">
        <img id="qvModalImg" src="" alt="Quick View Product">
      </div>
      <div class="qv-details-box">
        <div class="tagline-eyebrow" id="qvModalCategory"></div>
        <h3 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--text-main); margin: 8px 0 4px;" id="qvModalName"></h3>
        <div style="color: var(--text-dim); font-size: 0.85rem; margin-bottom: 14px;" id="qvModalSubtitle"></div>
        <div style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--gold-dark); font-weight: 700; margin-bottom: 16px;" id="qvModalPrice"></div>
        <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.7; margin-bottom: 20px;" id="qvModalDesc"></p>

        <div style="background: #FAF7F2; border: 1px solid var(--gold-border); padding: 14px 18px; border-radius: 6px; margin-bottom: 24px; font-size: 0.82rem;" id="qvNotesBox">
          <!-- Injected via JS -->
        </div>

        <div style="display: flex; gap: 14px;">
          <button class="btn-gold" id="qvAddToCartBtn" style="flex: 1;">Add to Bag</button>
          <a href="#" id="qvFullStoryLink" class="btn-secondary" style="padding: 14px 22px;">Full Story →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ LUXURY TOAST WRAPPER ════════════════════════════════════ -->
  <div class="luxury-toast-wrap" id="luxToastWrap"></div>

  <!-- Pass server data safely to client JS -->
  <script>
    window.ZAHAR_CATALOG = <%- JSON.stringify(products) %>;
    window.ZAHAR_OFFERS = <%- JSON.stringify(typeof maisonOffers !== 'undefined' ? maisonOffers : []) %>;
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
