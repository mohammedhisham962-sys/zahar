<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Private Concierge Checkout — ZAHAR Haute Parfumerie</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚜️</text></svg>">
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- ═══ CHECKOUT INTERFACE ═════════════════════════════════════ -->
  <main class="checkout-page-wrap">
    <div class="container">
      <div class="section-title-wrap" style="margin-bottom: 40px;">
        <div class="tagline-eyebrow">Encrypted Concierge Order</div>
        <h2>Finalize Your Acquisition</h2>
        <p>Complete your delivery coordinates to receive your hand-numbered flacon coffret</p>
      </div>

      <div class="checkout-grid">
        <!-- Left: Delivery Form -->
        <div class="checkout-form-card">
          <form action="/checkout/process" method="POST" id="checkoutForm">
            <div class="form-section-title">1. Patron Details & Dispatch Coordinates</div>

            <div class="form-row-2col">
              <div class="form-group">
                <label for="firstName">First Name *</label>
                <input type="text" id="firstName" name="firstName" required placeholder="e.g. Tariq">
              </div>
              <div class="form-group">
                <label for="lastName">Last Name *</label>
                <input type="text" id="lastName" name="lastName" required placeholder="e.g. Al-Mansoor">
              </div>
            </div>

            <div class="form-row-2col">
              <div class="form-group">
                <label for="email">Private Email *</label>
                <input type="email" id="email" name="email" required placeholder="For dispatch tracking updates">
              </div>
              <div class="form-group">
                <label for="phone">Phone / Mobile *</label>
                <input type="tel" id="phone" name="phone" required placeholder="+971 50 123 4567">
              </div>
            </div>

            <div class="form-group">
              <label for="address">Delivery Street Address *</label>
              <input type="text" id="address" name="address" required placeholder="Residence / Villa / Suite / Street">
            </div>

            <div class="form-row-2col">
              <div class="form-group">
                <label for="city">City *</label>
                <input type="text" id="city" name="city" required placeholder="e.g. Dubai, London, New York">
              </div>
              <div class="form-group">
                <label for="country">Country *</label>
                <select id="country" name="country">
                  <option value="United Arab Emirates">United Arab Emirates</option>
                  <option value="Saudi Arabia">Saudi Arabia</option>
                  <option value="Qatar">Qatar</option>
                  <option value="Kuwait">Kuwait</option>
                  <option value="United Kingdom">United Kingdom</option>
                  <option value="France">France</option>
                  <option value="United States">United States</option>
                  <option value="Switzerland">Switzerland</option>
                  <option value="Singapore">Singapore</option>
                </select>
              </div>
            </div>

            <div class="form-section-title" style="margin-top: 36px;">2. Payment Method</div>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px;">
              <label style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; border: 1px solid var(--gold); background: #FFFDF9; border-radius: 6px; cursor: pointer;">
                <input type="radio" name="paymentMethod" value="Encrypted Credit / Debit Card" checked>
                <span style="font-weight: 600;">Encrypted Credit / Debit Card (Visa, MasterCard, Amex)</span>
              </label>

              <label style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; border: 1px solid var(--gold-border); background: #FFFFFF; border-radius: 6px; cursor: pointer;">
                <input type="radio" name="paymentMethod" value="Apple Pay / Google Pay">
                <span style="font-weight: 600;">Apple Pay / Google Pay</span>
              </label>

              <label style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; border: 1px solid var(--gold-border); background: #FFFFFF; border-radius: 6px; cursor: pointer;">
                <input type="radio" name="paymentMethod" value="Cash On VIP Delivery (GCC Only)">
                <span style="font-weight: 600;">Cash On VIP Delivery (Available across UAE & GCC)</span>
              </label>
            </div>

            <button type="submit" class="btn-gold" style="width: 100%; padding: 18px; font-size: 0.85rem;">
              Confirm & Place Luxury Order →
            </button>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px;">
              <a href="/order-cancelled?reason=cancelled_by_user" style="font-size: 0.76rem; color: #C0392B; text-decoration: underline;">
                Cancel this acquisition
              </a>
              <span style="font-size: 0.72rem; color: var(--text-dim);">
                🔒 256-Bit SSL Encrypted
              </span>
            </div>
          </form>
        </div>

        <!-- Right: Order Summary -->
        <div class="checkout-summary-card">
          <div class="form-section-title">Order Manifest (<%= cartData.itemCount %> Items)</div>

          <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px;">
            <% cart.forEach(item => { %>
            <div style="display: flex; gap: 14px; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--gold-border);">
              <img src="<%= item.product.image || '/images/products/sovereign-oudh.jpg' %>" onerror="this.onerror=null; this.src='/images/products/sovereign-oudh.jpg';" alt="<%= item.product.name %>" style="width: 55px; height: 65px; object-fit: cover; border-radius: 4px; border: 1px solid var(--gold-border);">
              <div style="flex: 1;">
                <h5 style="font-family: var(--font-serif); font-size: 1rem; color: var(--text-main); margin-bottom: 2px;"><%= item.product.name %></h5>
                <span style="font-size: 0.72rem; color: var(--gold-dark);"><%= item.selectedSize %> • Qty: <%= item.quantity %></span>
              </div>
              <div style="font-family: var(--font-serif); font-weight: 700; color: var(--text-main);">
                $<%= (item.price * item.quantity).toFixed(2) %>
              </div>
            </div>
            <% }); %>
          </div>

          <!-- Included Privileges -->
          <div class="complimentary-gifts-box" style="margin-bottom: 24px;">
            <div style="font-family: var(--font-brand); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-dark); font-weight: 700; margin-bottom: 8px;">
              Included Compliments
            </div>
            <ul style="font-size: 0.8rem; color: var(--text-sub); list-style: none; display: flex; flex-direction: column; gap: 6px;">
              <li>✦ Complimentary 2ml Discovery Flacons (Set of 3)</li>
              <li>✦ Hand-Crafted Velvet Presentation Coffret with Wax Seal</li>
              <li>✦ CITES Certified Wild Agarwood Harvest Authentication</li>
            </ul>
          </div>

          <!-- Pricing Calculations -->
          <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 8px; color: var(--text-muted);">
            <span>Subtotal</span>
            <span>$<%= cartData.subtotal %></span>
          </div>

          <% if (cartData.discountPercent > 0) { %>
          <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 8px; color: #2E7D32; font-weight: 600;">
            <span>VIP Code (<%= cartData.couponCode %>)</span>
            <span>-$<%= cartData.discountAmount %></span>
          </div>
          <% } %>

          <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 8px; color: var(--text-muted);">
            <span>DHL Express Delivery</span>
            <span style="color: var(--gold-dark); font-weight: 600;">
              <%= parseFloat(cartData.subtotal) >= 150 ? 'Complimentary ($0.00)' : '$15.00' %>
            </span>
          </div>

          <div style="display: flex; justify-content: space-between; font-size: 1.4rem; font-family: var(--font-serif); font-weight: 700; color: var(--text-main); padding-top: 14px; border-top: 1px solid var(--gold-border); margin-top: 12px;">
            <span>Total</span>
            <span style="color: var(--gold-dark);">$<%= cartData.total %></span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
